# Copy to .env (or run `python manage.py genkeys`, which fills in the secrets for you).
# Never commit .env.

ENVIRONMENT=development

# SQLite for local development. For Postgres use e.g.:
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/options_trading
DATABASE_URL=sqlite+aiosqlite:///./trading.db

REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Required. Random 64-char hex string.
SECRET_KEY=
# Required. Fernet key. Changing it makes stored broker credentials unreadable.
ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# true enables /api/v1/paper-trading/seed-demo (sample trades). Keep false in production.
DEMO_MODE=false

# Set false on a public server after creating your own account.
ALLOW_REGISTRATION=true
